{
  "name": "@studymy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "tsx src/db/seed.ts",
    "import:official": "tsx src/db/import-official-directory.ts",
    "import:usm:undergraduate": "tsx src/db/import-usm-undergraduate-official.ts",
    "verify:usm:undergraduate": "tsx src/db/import-usm-undergraduate-official.ts --verify-only",
    "publish:usm:undergraduate": "tsx src/db/import-usm-undergraduate-commercial.ts",
    "verify:usm:undergraduate:commercial": "tsx src/db/import-usm-undergraduate-commercial.ts --verify-only",
    "extract:static": "tsx src/db/extract-static-html.ts",
    "import:static": "tsx src/db/import-static-html.ts",
    "check:static": "tsx src/db/verify-static-html.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@studymy/shared": "file:../../packages/shared",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.8.1",
    "mysql2": "^3.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
