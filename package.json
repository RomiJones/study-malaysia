{
  "name": "study-malaysia",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/admin",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm --workspace @studymy/api run start:dev",
    "dev:web": "npm --workspace @studymy/web run dev",
    "dev:admin": "npm --workspace @studymy/admin run dev",
    "preview:admin": "npm --workspace @studymy/admin run preview",
    "build": "npm run build --workspaces",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify:task013": "node scripts/task013-member-api-verify.mjs",
    "verify:task014": "node scripts/task014-admin-cms-verify.mjs",
    "verify:task022": "node scripts/task022-visual-baseline.mjs",
    "verify:task024": "node scripts/task024-university-detail-visual.mjs",
    "verify:task025": "node scripts/task025-program-visual.mjs",
    "verify:task026": "node scripts/task026-tools-visual.mjs",
    "verify:task027": "node scripts/task027-mobile-visual.mjs",
    "verify:task028": "node scripts/task028-final-visual-regression.mjs",
    "extract:static-assets": "node scripts/task036-extract-static-html-assets.mjs",
    "verify:static-assets": "node scripts/task036-verify-static-html-assets.mjs",
    "verify:static-assets:browser": "node scripts/task036-browser-verify-static-html-assets.mjs",
    "verify:task037:images": "node scripts/task037-verify-user-image-fields.mjs",
    "verify:task037:browser": "node scripts/task037-user-image-screenshots.mjs",
    "verify:task038:assets": "node scripts/task038-verify-small-assets.mjs",
    "verify:task039:images": "node scripts/task039-image-regression.mjs",
    "verify:task040:i18n": "tsx --tsconfig tsconfig.test.json scripts/task040-i18n-audit.ts",
    "verify:task040:browser": "node scripts/task035-final-release-audit.mjs",
    "seed": "npm --workspace @studymy/api run seed",
    "extract:static": "npm --workspace @studymy/api run extract:static",
    "import:static": "npm --workspace @studymy/api run import:static --",
    "check:static": "npm --workspace @studymy/api run check:static --"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
